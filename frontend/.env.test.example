# Copiar como .env.test y ajustar SOLO los datos locales necesarios.

# ============================================================
# LERNA PLAYWRIGHT - SOLO LOCAL
# ============================================================
PW_BASE_URL=http://127.0.0.1:3100
PW_API_URL=http://127.0.0.1:3101/routes
PW_BACKEND_DIR=../backend

PW_LOCAL_ONLY=1
PW_ALLOW_MUTATIONS=1

PW_TENANT_ID=1
PW_EXPECTED_TENANT_ID=1
PW_EXPECTED_TENANT_NAME=

PW_ADMIN_USER=admin
PW_ADMIN_PASSWORD=1234

# Opcional: si ambos quedan vacíos, Playwright crea un usuario vista temporal.
PW_VISTA_USER=
PW_VISTA_PASSWORD=

PW_TEST_PREFIX=PWTEST

PW_START_FRONTEND=true
PW_START_BACKEND=true
PW_FRONTEND_COMMAND=npm start
PW_BACKEND_HOST=127.0.0.1
PW_BACKEND_PORT=3101
PW_FRONTEND_PORT=3100
