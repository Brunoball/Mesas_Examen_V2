# Copiar como .env.test. Esta suite bloquea mutaciones fuera de localhost.
PW_BASE_URL=http://127.0.0.1:3200
PW_API_URL=http://127.0.0.1:3201/routes
PW_BACKEND_DIR=../backend

PW_LOCAL_ONLY=1
PW_ALLOW_MUTATIONS=1
PW_TENANT_ID=1
PW_EXPECTED_TENANT_ID=1

PW_ADMIN_USER=admin
PW_ADMIN_PASSWORD=1234
PW_TEST_PREFIX=PWFORM

PW_START_FRONTEND=true
PW_START_BACKEND=true
PW_FRONTEND_COMMAND=npm start
PW_BACKEND_HOST=127.0.0.1
PW_BACKEND_PORT=3201
PW_FRONTEND_PORT=3200
